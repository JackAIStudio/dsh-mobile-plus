{
  "name": "dsh-mobile-plus",
  "version": "0.2.7",
  "private": true,
  "description": "Independent DSH mobile remote: chat with text and images, with an icon-only desktop sidebar trigger and pairing panel. Does not modify @linxin666/dsh-web-all.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "qrcodegen.js",
    "public",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
